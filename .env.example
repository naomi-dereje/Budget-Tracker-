# ===================================================================
# Student Budget Tracker - Environment Configuration Template
# Copy this file to .env or set environment variables in your runtime
# NEVER commit your real .env file with production secrets to Git!
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# Active Spring Profile (e.g., 'mysql' for MySQL 8, 'dev' for in-memory H2 development)
SPRING_PROFILES_ACTIVE=mysql

# MySQL 8 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_budget_tracker
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JPA / Hibernate DDL behavior ('update' for development, 'validate' for production)
JPA_HIBERNATE_DDL_AUTO=update

# Session & Security Settings
SESSION_TIMEOUT_MINUTES=60
REMEMBER_ME_KEY=StudentBudgetTrackerSecretKeyReplaceInProduction2026!
